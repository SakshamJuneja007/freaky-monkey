@"
# ================================
# Python
# ================================
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# ================================
# Environment / secrets
# ================================
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/

# ================================
# DEIMOS runtime state
# ================================
agent_memory_space/

# Keep source code inside agent_memory_space only if explicitly forced
# Uncomment specific exceptions if you later decide to version them.

# ================================
# Runtime logs / traces
# ================================
*.log
*.jsonl
logs/
runtime_logs/
runs/
artifacts/
results/

# ================================
# Browser / Chromium data
# ================================
**/Default/
**/Cache/
**/Code Cache/
**/GPUCache/
**/ShaderCache/
**/GrShaderCache/
**/Crashpad/
**/IndexedDB/
**/Local Storage/
**/Session Storage/
**/Sessions/
**/Service Worker/
**/Storage/
**/Network/
**/*Cookies*
**/*History*
**/*Login Data*
**/*Web Data*
**/*Account Web Data*
**/*Preferences*
**/*Secure Preferences*
**/DevToolsActivePort
**/Local State
**/First Run
**/Last Version
**/Variations*
**/*Metrics*
**/*.pma

# ================================
# Browser automation artifacts
# ================================
playwright-report/
test-results/
blob-report/
screenshots/
videos/
traces/

# ================================
# IDE / editors
# ================================
.vscode/
.idea/
*.code-workspace

# ================================
# OS junk
# ================================
.DS_Store
Thumbs.db
desktop.ini

# ================================
# Temporary files
# ================================
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
@"

# ================================
# DEIMOS local/runtime state
# ================================
.agent_memory/
.sandbox/
.claude/

# Local agent state
*.state
*.session
*.lock
*.zip
.agent_state/
"@ | Add-Content -Encoding UTF8 .gitignore
