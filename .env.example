# Copy to .env and fill in. .env is gitignored; this file is not, so it must
# never contain a real key.
#
# Any OpenAI-compatible provider works (plan S24: model choice is an
# experimental variable). Defaults below are for NVIDIA NIM.
# Endpoint: https://integrate.api.nvidia.com/v1/chat/completions

# --- planner (the structured-first condition under test) ---
LLM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=openai/gpt-oss-120b

# Reasoning models (gpt-oss, o-series, DeepSeek-R1) bill hidden reasoning
# against max_tokens and emit it before any content, so a ceiling sized for the
# answer alone yields truncated JSON. Raise this, do not lower it.
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0

# --- vision-only baseline (plan S18) ---
# Must be a model that accepts images. gpt-oss-120b is text-only, so it cannot
# serve as the baseline VLM; pick a vision model on the same provider and note
# the deviation from plan S18's "same model" when reporting results. Keep it
# close in scale to the planner -- a weak baseline flatters the hybrid, which
# plan S22 names as a kill condition.
# Leave all three blank to fall back to the LLM_* values above -- only correct
# when LLM_MODEL is itself multimodal.
VLM_MODEL=meta/llama-3.2-90b-vision-instruct
VLM_BASE_URL=https://integrate.api.nvidia.com/v1
VLM_API_KEY=
# Big hosted VLMs cold-start slowly; without headroom a queue wait is recorded
# as a baseline failure instead of a wait.
VLM_TIMEOUT_S=300

# --- cost estimation (USD per 1M tokens) ---
# Default for `python main.py bench`; --price-in/--price-out override.
LLM_PRICE_INPUT_PER_M=0
LLM_PRICE_OUTPUT_PER_M=0

# --- speech to text (voice input, plan: thin interface layer only) ---
# Measured, not assumed: NVIDIA's OpenAI-compatible host has no
# /audio/transcriptions route (404). Every ACTIVE speech function this key can
# invoke reports apiBodyFormat=CUSTOM with health.protocol=gRPC, so STT goes
# through NVCF's gRPC gateway with a Riva client, not httpx.
#   pip install nvidia-riva-client sounddevice
# Leave STT_API_KEY blank to reuse LLM_API_KEY (same nvapi credential; two
# copies of one key only drift apart).
STT_API_KEY=
STT_GRPC_URI=grpc.nvcf.nvidia.com:443
# ai-whisper-large-v3, found by enumerating /v2/nvcf/functions with this key.
# Verified: 4.33 s known-text WAV transcribed word for word in 3.31 s; 66 s of
# unique speech returned complete with the final sentence intact.
STT_FUNCTION_ID=b702f636-f60c-4a3d-a6f4-f3568c13bd7d
STT_LANGUAGE=en-US
STT_PROVIDER=nvidia-riva/whisper-large-v3
STT_TIMEOUT_S=120

# --- text to speech (voice output; a separate layer, off by default) ---
# Windows SAPI through System.Speech, which ships with the OS: no new
# dependency, no network call, no audio leaves the machine. Measured on this
# box: ~2.4 s fixed overhead per utterance (PowerShell start + Add-Type), so
# utterances run on a background thread and never delay the agent loop.
# Off by default on purpose -- adding an output layer must not change how the
# tool already behaves. `python main.py run ... --speak` overrides this, and
# `--no-speak` overrides the file.
TTS_ENABLED=0
# Blank means the system default. `python main.py say --list-voices` lists what
# is installed; an unknown name is ignored rather than failing the utterance.
TTS_VOICE=
# SAPI rate, -10..10, 0 being the voice's natural speed. Clamped.
TTS_RATE=0
TTS_TIMEOUT_S=60
